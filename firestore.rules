rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Usuarios ──────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /ai_outfits/{outfitId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Posts ─────────────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.userId ||
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['likes', 'likedBy']));
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.userId;

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow delete: if request.auth != null &&
          request.auth.uid == resource.data.userId;
      }
    }

    // ── Armario ───────────────────────────────────────────────────────────────
    match /wardrobe/{uid}/items/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Foro ──────────────────────────────────────────────────────────────────
    match /forum/{threadId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.userId ||
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['likes', 'likedBy']));
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.userId;

      match /replies/{replyId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow delete: if request.auth != null &&
          request.auth.uid == resource.data.userId;
      }
    }

    // ── Historias ─────────────────────────────────────────────────────────────
    match /stories/{storyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy']);
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.userId;
    }

    // ── Conversaciones ────────────────────────────────────────────────────────
    match /conversations/{convId} {
      allow list: if request.auth != null;
      allow get, write: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;

      match /messages/{msgId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid;
      }
    }

    // ── Notificaciones ────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read, update: if request.auth != null
        && request.auth.uid == resource.data.toUid;
      allow create: if request.auth != null;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.toUid;
    }
  }
}
